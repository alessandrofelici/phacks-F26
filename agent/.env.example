# Repro Bot agent settings. Copy this file to `.env` in the REPO ROOT (not in agent/):
#
#     cp agent/.env.example .env
#
# `.env` is gitignored. Never commit a real key. Check the result with:
#
#     python -m agent.check          # what would be used
#     python -m agent.check --call   # plus one tiny request to the model

# ---------------------------------------------------------------------------
# Required: one model key
# ---------------------------------------------------------------------------

# OpenRouter (https://openrouter.ai/keys). One key reaches every model below.
OPENROUTER_API_KEY=

# Which model the agent uses. Any LangChain "provider:model" string.
# OpenRouter ids are "openrouter:<vendor>/<model>", exactly as listed on openrouter.ai/models.
# Prices are per million tokens (input / output), read from OpenRouter on 2026-11-14.
#   openrouter:anthropic/claude-opus-5.5     $4 / $20     default
#   openrouter:anthropic/claude-sonnet-5.5   $2 / $10
#   openrouter:anthropic/claude-haiku-5.5    $0.10 / $0.50
#   openrouter:anthropic/claude-fable-5.2    $8 / $40
# The model must support tool calling.
REPRO_MODEL=openrouter:anthropic/claude-opus-5.5

# Optional: a cheaper model for the four subagents (paper-reader, env-builder, runner,
# result-judge). Leave empty to use REPRO_MODEL for everything.
REPRO_SUBAGENT_MODEL=

# Shown on your OpenRouter activity page, so runs are easy to find there.
OPENROUTER_APP_TITLE=Repro Bot

# Alternative to OpenRouter: Anthropic's API directly. Only needed if REPRO_MODEL starts
# with "anthropic:" (for example anthropic:claude-opus-5-5).
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional: LangSmith trace link (https://smith.langchain.com, free tier)
# ---------------------------------------------------------------------------
# With these set, each run is one trace in LangSmith and report.json's `trace_url` links to it.
# Without them the agent works the same and `trace_url` is null.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=repro-bot

# ---------------------------------------------------------------------------
# Optional: how runs behave (defaults shown)
# ---------------------------------------------------------------------------

# Where the paper's code runs: auto (Podman when installed, else local), podman, local.
# "local" has no isolation: the paper's code can read this disk, answer keys included.
# REPRO_SANDBOX=auto
# REPRO_SANDBOX_IMAGE=docker.io/library/python:3.12-slim

# Seconds a setup command may run before it needs an approval.
# REPRO_SHORT_TIMEOUT=90

# Seconds to wait for a human's decision on an approval (the contract says 600).
# REPRO_APPROVAL_TIMEOUT=600

# Where fixes remembered across runs are kept, and where workspaces are made.
# REPRO_MEMORY_DIR=agent/.memory
# REPRO_WORK_ROOT=/tmp

# Debugging: keep the workspace after a run; print the agent's raw stream to stderr.
# REPRO_KEEP_WORK=1
# REPRO_DEBUG=1
